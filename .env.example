# ─────────────────────────────────────────────
# PEP — Personal Email Platform
# Environment Variables
# ─────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file and rename to .env.local
#   2. Replace every REPLACE_WITH_* value with your actual key
#   3. NEVER commit .env.local to git
# ─────────────────────────────────────────────

# ── Resend ────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY

# Get from: Resend Dashboard → Webhooks → Signing Secret
RESEND_WEBHOOK_SECRET=REPLACE_WITH_RESEND_WEBHOOK_SECRET_WHSEC

# ── Supabase ──────────────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# ── Upstash Redis (Rate Limiting) ─────────────
# Get from: https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_REDIS_REST_TOKEN

# ── App Config ────────────────────────────────
# Your deployed app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=REPLACE_WITH_YOUR_APP_URL

# The email domain users receive mail at (e.g. mail.yourdomain.com)
ALLOWED_EMAIL_DOMAIN=REPLACE_WITH_YOUR_INBOUND_EMAIL_DOMAIN

# App display name (shown in invite emails, UI header)
NEXT_PUBLIC_APP_NAME=PEP Mail
